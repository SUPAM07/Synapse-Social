datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  user
  admin
}

model User {
  id          String   @id @default(uuid())
  login       String   @unique
  password    String
  email       String   @unique
  isConfirmed Boolean  @default(false)
  fullName    String
  picturePath String?
  role        Role     @default(user)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("users")
}
