datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model EventFormat {
  id     String  @id @default(uuid())
  name   String  @unique
  events Event[]

  @@map("event_formats")
}

model EventTheme {
  id     String  @id @default(uuid())
  name   String  @unique
  events Event[]

  @@map("event_themes")
}

model Event {
  id          String      @id @default(uuid())
  title       String
  description String?
  organizerId String
  formatId    String?
  themeId     String?
  startDate   DateTime
  endDate     DateTime
  location    String
  latitude    Float?
  longitude   Float?
  price       Float       @default(0)
  capacity    Int
  picturePath String?
  isPublished Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  format      EventFormat? @relation(fields: [formatId], references: [id])
  theme       EventTheme?  @relation(fields: [themeId], references: [id])
  comments    Comment[]

  @@map("events")
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  userId    String
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("comments")
}
